# Evidentia UI — development environment example.
# Copy to .env.local for local overrides. Vite reads VITE_* vars at build time.

# Optional: override the backend URL in dev mode (defaults to /api via Vite proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: static demo-mode build. When set to "true" the bundle ships with no
# backend — the API client is swapped for baked Meridian-v2 fixtures, the two SSE
# routes render canned final states, routing uses HashRouter for static subpath
# hosting, and a persistent "DEMO · synthetic data · no live backend" banner is
# shown. Used only for the public demo deploy (`VITE_DEMO=true npm run build`);
# leave it unset for every normal build so the UI talks to the real API.
# VITE_DEMO=true
