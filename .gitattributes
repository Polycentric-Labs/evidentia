# Pin the GitHub About source-of-truth file to LF so a trailing CR can
# never sneak into `gh repo edit --description "$(cat .github/repo-description.txt)"`
# on Windows checkouts (core.autocrlf=true). See docs/release-checklist.md Step 7.
.github/repo-description.txt text eol=lf

# Fuzz crash reproducers are exact-byte FuzzedDataProvider inputs: the
# trailing bytes drive ext/int selection, so EOL normalization (LF->CRLF on a
# Windows checkout) would change the bytes the harness replays. Treat them as
# binary so git never touches them. Seed corpus JSON stays text.
tests/fuzz/corpus/**/crash-* binary

# The vendored FedRAMP schemas are pinned to upstream by sha256 of their bytes
# (UPSTREAM.json sha256_upstream). Upstream publishes LF; keep the checkout LF
# on every platform so `sha256sum <file>` matches the pin, not only the
# EOL-independent `git hash-object` blob id.
packages/evidentia-core/src/evidentia_core/fedramp/schemas/*.json text eol=lf

# Registry source hashes bind exact LF bytes on every checkout.
packages/evidentia-collectors/src/evidentia_collectors/registries/data/fcc/snapshot.json text eol=lf
packages/evidentia-collectors/src/evidentia_collectors/registries/data/fedramp/snapshot.json text eol=lf
packages/evidentia-collectors/src/evidentia_collectors/registries/data/incommon/production-signing-certificate.json text eol=lf
packages/evidentia-collectors/src/evidentia_collectors/registries/data/rdap/bootstrap.json text eol=lf
packages/evidentia-collectors/src/evidentia_collectors/registries/data/source-index.json text eol=lf
tests/fixtures/registries/fedramp/full-source-tuples.json text eol=lf
tests/fixtures/registries/fcc/full-source-tuples.json text eol=lf
tests/fixtures/registries/source-index.json text eol=lf
